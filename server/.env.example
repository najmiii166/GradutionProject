# Server environment configuration for MentorLink API

# MongoDB connection string (required)
# Example local: mongodb://127.0.0.1:27017/mentorlink
# Example Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/mentorlink
MONGO_URI=

# JWT secret for auth tokens (required)
JWT_SECRET=

# Frontend origin for CORS (optional in dev; defaults include http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Optional: Gemini key for AI features (assistant, mentor request analysis)
GEMINI_API_KEY=

# Optional: override port (defaults to 8080)
# PORT=8080
